appname               = waterfish_anthology
version               = 1.2.4
display_name           = 水鱼文集
desc                  = 面向写作与内容整理的 Markdown 文集：文章库、图片库（本地 / Cloudinary 图床，支持预览与批量处理）、SEO 检测与自定义存储路径；可直接打开磁盘上的 Markdown / 纯文本 / Word / PDF / EPUB 等文档，.md 与纯文本编辑保存，版式文档只读预览并可另存为文章；支持从任意文件夹导入、把外部文件加入文章库；内置多平台统一发布。接入飞牛统一网关，NAS 账号免登打开，各账号数据独立。
source                = thirdparty
platform              = x86

maintainer            = waterfish
maintainer_url        = https://github.com/12hgl/waterfish_anthology

os_min_version        = 1.2.0401

desktop_uidir         = ui
desktop_applaunchname = waterfish_anthology.main

service_port          = 8631
checkport             = true
ctl_stop              = true

micro_app             = true

changelog             = 1.2.4 优化：① 主题支持简单 / 复杂两种 js 写法，复杂主题可调界面、动画与图标；② 收起侧栏按钮移到顶部，账号与外观内置在侧栏底部；③ 平台密钥改在「发布设置」里配置，发布弹窗只设封面、标题等每篇文章不同的内容；④ 关于与更新合并为一个子菜单；⑤ SEO 检测升级为网页检测：在本地检测网页的 SEO 与 AI Agent 就绪度，不访问网络。1.2.3 优化：草稿式保存、外观抽屉与声明式主题。1.2.2 新增：图片库灯箱预览与批量处理、图床预连接、复制发布图片直链、发布体系统一化。
