#!/bin/bash
### 水鱼文集 —— 启动 / 停止 / 状态
### 由飞牛 fnOS 调用：main start | main stop | main status

set -u

APP_BIN="${TRIM_APPDEST:-.}/server/waterfish-anthology"
LOG_FILE="${TRIM_PKGVAR:-.}/info.log"
PID_FILE="${TRIM_PKGVAR:-.}/app.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null
}

user_error() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}"
    fi
}

check_process() {
    local pid="${1:-}"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

running() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}" 2>/dev/null
    fi
    return 1
}

start_process() {
    if running; then
        log_msg "already running, skip start"
        return 0
    fi

    if [ ! -x "${APP_BIN}" ]; then
        user_error "未找到可执行文件：${APP_BIN}，请重新安装应用。"
        log_msg "binary not found or not executable: ${APP_BIN}"
        return 1
    fi

    mkdir -p "${TRIM_PKGETC:-.}" "${TRIM_PKGVAR:-.}" 2>/dev/null
    [ -f "${LOG_FILE}" ] || : > "${LOG_FILE}" 2>/dev/null

    log_msg "starting ${APP_BIN} (port=${TRIM_SERVICE_PORT:-8631})"
    "${APP_BIN}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf '%s' "${pid}" > "${PID_FILE}"

    local count=0
    while [ ${count} -lt 8 ]; do
        sleep 1
        if check_process "${pid}"; then
            log_msg "started pid=${pid}"
            return 0
        fi
        count=$((count + 1))
    done

    user_error "水鱼文集启动失败，详见 ${LOG_FILE}"
    log_msg "failed to start"
    return 1
}

stop_process() {
    if ! [ -f "${PID_FILE}" ]; then
        log_msg "no pid file, nothing to stop"
        return 0
    fi

    local pid
    pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}" 2>/dev/null
        log_msg "process ${pid} not running, removed pid file"
        return 0
    fi

    log_msg "sending TERM to pid=${pid}"
    kill -TERM "${pid}" 2>/dev/null

    local count=0
    while check_process "${pid}" && [ ${count} -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        log_msg "sending KILL to pid=${pid}"
        kill -KILL "${pid}" 2>/dev/null
        sleep 1
    fi

    rm -f "${PID_FILE}" 2>/dev/null
    log_msg "stopped"
    return 0
}

case "${1:-}" in
    start)
        start_process
        exit $?
        ;;
    stop)
        stop_process
        exit $?
        ;;
    restart)
        stop_process
        start_process
        exit $?
        ;;
    status)
        if running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        user_error "未知命令：${1:-}"
        exit 1
        ;;
esac
