#!/bin/bash
### 配置变更后：重启服务，让应用重新读取 TRIM_DATA_ACCESSIBLE_PATHS 等环境变量
### （用户在「应用设置 - 授权目录」新增文件夹后，需要重启才能识别）
set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if ! "${SCRIPT_DIR}/main" restart >/dev/null 2>&1; then
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "授权目录已保存，但服务重启失败，请到应用中心手动启动一次水鱼文集。" > "${TRIM_TEMP_LOGFILE}"
    fi
fi
exit 0
